# Copy to .env and fill in. Portal creds = ONE shared agency login.
PORTAL_BASE_URL=https://agent.letsgomaldives.com
PORTAL_LOGIN_PATH=/login/
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Agency rate code for pricing (account-specific)
PORTAL_RATE_CODE=7ZV5P
# Session / guard tuning
MAX_CONCURRENT_PORTAL_REQUESTS=4
PORTAL_TIMEOUT_SECONDS=30
# Sell-price markup percent over portal net room prices (transfers untouched)
MARKUP=10
LOG_LEVEL=info
NATIONALITY_MAPPING_PATH=lib/data/nationality_mapping.json
PORT=8000
# CMS admin (single admin role). Unset = /admin/* answers 503, app still boots.
ADMIN_USER=admin
ADMIN_PASSWORD=1q2w3e4r
ADMIN_JWT_SECRET=1q2w3e4r
# CMS JSON file store (committed source of truth; commit after big imports)
CMS_JSON_PATH=data/cms.json
