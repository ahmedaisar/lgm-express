# Copy to .env locally or configure these as Vercel environment variables.
# Use a dedicated portal account. Never commit actual credentials.
PORTAL_BASE_URL=https://unihotel.org
PORTAL_LOGIN_PATH=/ajax-login/
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Agency rate code for pricing (account-specific; confirm before production use)
PORTAL_RATE_CODE=7ZV5P
# Session / guard tuning
MAX_CONCURRENT_PORTAL_REQUESTS=4
PORTAL_TIMEOUT_SECONDS=30
# Sell-price markup percent over portal net room prices (transfers untouched)
MARKUP=10
LOG_LEVEL=info
NATIONALITY_MAPPING_PATH=lib/data/nationality_mapping.json
PORT=8000
# Admin configuration. Use unique high-entropy values in production.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Allowed browser origins, comma-separated; empty means no browser origins allowed.
ALLOWED_ORIGINS=https://your-frontend.example
# Process-local limits; add edge/distributed rate limiting for serverless production.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# CMS JSON file store (local development only; use durable storage in production)
CMS_JSON_PATH=data/cms.json
